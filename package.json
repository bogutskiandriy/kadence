{
  "name": "kadence",
  "version": "0.1.5",
  "description": "Tasks, sprints and velocity as plain files inside your git repository",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kadence": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "cac": "^7.0.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "cli",
    "git",
    "task",
    "sprint",
    "velocity",
    "kanban",
    "tui",
    "project-management",
    "ai-agents",
    "event-sourcing",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogutskiandriy/kadence.git"
  },
  "homepage": "https://github.com/bogutskiandriy/kadence#readme",
  "bugs": {
    "url": "https://github.com/bogutskiandriy/kadence/issues"
  }
}
